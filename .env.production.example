# Copy to .env.production; restrict access: chmod 600 .env.production
# Generate a URL-safe random password: openssl rand -hex 32
POSTGRES_PASSWORD=
APP_ORIGIN=https://content.example.com
PROXY_NETWORK=existing_proxy_network
APP_IMAGE=rooz-content:latest
FILE_MAX_BYTES=314572800
SESSION_TTL_DAYS=30
# One trusted reverse-proxy hop. Adjust to the actual topology.
TRUST_PROXY=1
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
