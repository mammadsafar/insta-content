# Copy to .env. Generate your own URL-safe password with: openssl rand -hex 32
POSTGRES_PASSWORD=
APP_ORIGIN=http://localhost:3000
LOCAL_APP_PORT=3000
FILE_MAX_BYTES=104857600
SESSION_TTL_DAYS=30
# Optional Web Push. Generate a pair with the documented web-push command.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
