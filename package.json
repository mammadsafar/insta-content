{
  "name": "rooz-content-operations",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "dev:web": "vite --host 0.0.0.0",
    "build": "tsc -p tsconfig.server.json && vite build",
    "start": "node dist/server/index.js",
    "worker": "tsx server/worker.ts",
    "worker:production": "node dist/server/worker.js",
    "migrate": "tsx scripts/migrate.ts",
    "bootstrap": "tsx scripts/bootstrap.ts",
    "check": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "tsx --import ./tests/database-guard.mjs --test --test-concurrency=1 tests/*.test.ts",
    "test:unit": "tsx --test tests/content-schedule.test.ts tests/operations-time.test.ts tests/operations-validation.test.ts tests/media-storage.test.ts tests/compose.test.ts",
    "test:coverage": "c8 --reporter=text --reporter=lcov npm test",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.0.2",
    "@fastify/multipart": "^9.0.3",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.7",
    "archiver": "^7.0.1",
    "fastify": "^5.6.1",
    "file-type": "^21.0.0",
    "image-size": "^2.0.2",
    "jalaali-js": "^1.2.8",
    "lucide-react": "^0.468.0",
    "pg": "^8.16.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sharp": "^0.35.5",
    "web-push": "^3.6.7",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@types/archiver": "^6.0.3",
    "@types/jalaali-js": "^1.2.0",
    "@types/node": "^24.5.2",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.14",
    "@types/react-dom": "^19.1.9",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.0.0",
    "c8": "^10.1.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "vite": "^8.0.0"
  }
}
